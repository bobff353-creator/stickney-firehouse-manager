{
  "name": "stickney-firehouse-manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:sites": "node node_modules/vinext/dist/cli.js build",
    "start": "next start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint:preplan-v2": "eslint app/preplans app/respond.tsx app/respond-*.ts app/api/field-preplans app/api/respond tests/preplan-v2-*.test.mjs scripts/verify-preplan-v2.mjs --ignore-pattern .next",
    "test:preplan-v2": "node scripts/verify-preplan-v2.mjs",
    "verify:preplan-v2": "npm run lint:preplan-v2 && npm run build && npm run test:preplan-v2",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .work --ignore-pattern node_modules-* --ignore-pattern build --ignore-pattern db --ignore-pattern examples --ignore-pattern vercel --ignore-pattern worker",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "@zxing/browser": "0.2.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "standardwebhooks": "^1.0.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
