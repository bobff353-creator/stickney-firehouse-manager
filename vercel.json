{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/cad-push",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/board-feeds",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/daily-refresh",
      "schedule": "15 9 * * *"
    }
  ]
}
