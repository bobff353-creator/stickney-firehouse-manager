{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "codex/recovered-dot-20261017": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/dispatch-recovery",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/scheduler-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/cad-push",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/board-feeds",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/daily-refresh",
      "schedule": "15 9 * * *"
    }
  ]
}
