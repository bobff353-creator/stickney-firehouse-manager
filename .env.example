SUITE_COMMAND_URL=https://department-360-command-center.vercel.app
SUITE_INTEGRATION_SECRET=
AUTH_EMAIL_FROM=Stickney Firehouse Manager <no-reply@auth.stickneyfire.com>
SUPABASE_SEND_EMAIL_HOOK_SECRET=
SUPABASE_SECRET_KEY=
# Optional server-only backup status. Scoped Management token: Backups Read only.
# Must match the project in NEXT_PUBLIC_SUPABASE_URL. Never NEXT_PUBLIC_ prefix.
SUPABASE_BACKUP_ACCESS_TOKEN=
SUPABASE_BACKUP_PROJECT_REF=
# Optional UTC minimum recovery point after a data import/cutover.
SUPABASE_BACKUP_REQUIRED_AFTER=
# Optional deployment-specific source identity for CLI releases: exact 40-character Git SHA.
# Supply per deployment; do not persist a stale revision as a project-wide environment variable.
# Git-connected releases can use VERCEL_GIT_COMMIT_SHA automatically.
APP_RELEASE_SHA=
