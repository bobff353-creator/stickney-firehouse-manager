# --- Database (libSQL / Turso) ---
# Local dev can use a file database (created automatically):
CAD_DATABASE_URL=file:./cad.db
# For production, use a Turso database URL + auth token instead:
# CAD_DATABASE_URL=libsql://your-db.turso.io
# CAD_DATABASE_AUTH_TOKEN=your-turso-token

# --- Session signing ---
# A long random string used to sign login session cookies. REQUIRED in production.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
CAD_SESSION_SECRET=change-me-to-a-long-random-string

# --- Seed dispatcher (created on first boot if no users exist) ---
CAD_ADMIN_EMAIL=admin@example.com
CAD_ADMIN_PASSWORD=change-me-now
CAD_ADMIN_NAME=Dispatch Administrator

# --- Optional ---
# Label shown in outbound webhook envelopes and as the CAD "source".
CAD_SOURCE_NAME=CAD Dispatch
